# ==================================================
# SwasthyaSetu AI — Environment Variables Template
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control
# ==================================================

# ---- AI API Configuration ----
# Provide either Gemini or OpenAI API key for real AI assessment
# If both are empty, the app uses the deterministic fallback (works without API key)
AI_API_KEY=
NEXT_PUBLIC_AI_API_KEY=
AI_PROVIDER=gemini   # Options: gemini, openai

# ---- Database ----
# For production: PostgreSQL connection string
# DATABASE_URL=postgresql://user:password@localhost:5432/swasthyasetu
# For development: SQLite path (if using Prisma)
# DATABASE_URL=file:./dev.db

# ---- Authentication ----
# Generate a secure random string: openssl rand -base64 32
JWT_SECRET=your-secure-jwt-secret-here-change-this-in-production

# ---- Maps ----
# OpenStreetMap is used by default (no API key required)
# Optionally provide Google Maps or Mapbox key for enhanced maps
# MAPS_PROVIDER=openstreetmap  # Options: openstreetmap, googlemaps, mapbox
# MAPS_API_KEY=

# ---- Application ----
# Your deployment URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Emergency Services (Region-Specific) ----
# Customize emergency numbers for your region
# NEXT_PUBLIC_EMERGENCY_NUMBER=112
# NEXT_PUBLIC_AMBULANCE_NUMBER=108

# ---- Email / SMS (Optional — not required for demo) ----
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# TWILIO_SID=
# TWILIO_AUTH=
# TWILIO_PHONE=
